--cpu Cortex-M3
"motor_control\startup_stm32f103xe.o"
"motor_control\main.o"
"motor_control\gpio.o"
"motor_control\stm32f1xx_it.o"
"motor_control\stm32f1xx_hal_msp.o"
"motor_control\stm32f1xx_hal_gpio_ex.o"
"motor_control\stm32f1xx_hal_tim.o"
"motor_control\stm32f1xx_hal_tim_ex.o"
"motor_control\stm32f1xx_hal.o"
"motor_control\stm32f1xx_hal_rcc.o"
"motor_control\stm32f1xx_hal_rcc_ex.o"
"motor_control\stm32f1xx_hal_gpio.o"
"motor_control\stm32f1xx_hal_dma.o"
"motor_control\stm32f1xx_hal_cortex.o"
"motor_control\stm32f1xx_hal_pwr.o"
"motor_control\stm32f1xx_hal_flash.o"
"motor_control\stm32f1xx_hal_flash_ex.o"
"motor_control\stm32f1xx_hal_uart.o"
"motor_control\stm32f1xx_hal_usart.o"
"motor_control\system_stm32f1xx.o"
"motor_control\led.o"
"motor_control\uart.o"
"motor_control\tim.o"
